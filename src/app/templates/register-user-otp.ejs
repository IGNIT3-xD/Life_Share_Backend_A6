<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verification</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif; color:#333;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f6f8; padding:40px 15px;">
        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="max-width:520px; background:#ffffff; border-radius:12px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background:#2563eb; padding:30px 20px;">
                            <h1 style="margin:0; color:#ffffff; font-size:26px;">
                                Verify Your Account
                            </h1>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:35px 30px;">

                            <p style="margin:0 0 15px; font-size:16px;">
                                Hello <strong>
                                    <%= userName %>
                                </strong>,
                            </p>

                            <p style="margin:0 0 25px; font-size:15px; line-height:1.6; color:#555;">
                                We received a request to verify your account.
                                Use the OTP below to Verify your account.
                            </p>

                            <!-- OTP -->
                            <div style="text-align:center; margin:30px 0;">
                                <div style="
                                    display:inline-block;
                                    padding:18px 30px;
                                    background:#f0f5ff;
                                    border:2px dashed #2563eb;
                                    border-radius:10px;
                                ">
                                    <span style="
                                        font-size:32px;
                                        font-weight:bold;
                                        letter-spacing:8px;
                                        color:#2563eb;
                                    ">
                                        <%= otp %>
                                    </span>
                                </div>
                            </div>

                            <!-- Expiration -->
                            <p style="
                                margin:0 0 25px;
                                text-align:center;
                                font-size:14px;
                                color:#666;
                            ">
                                This OTP will expire in
                                <strong>
                                    <%= expTime %>
                                </strong>Minutes.
                            </p>

                            <p style="margin:0 0 15px; font-size:14px; line-height:1.6; color:#666;">
                                If you did not request a password reset, you can safely
                                ignore this email. Your password will remain unchanged.
                            </p>

                            <p style="margin:25px 0 0; font-size:14px; color:#555;">
                                Regards,<br>
                                <strong>Life Share</strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background:#f8fafc; padding:20px;">
                            <p style="margin:0; font-size:12px; color:#999;">
                                This is an automated email. Please do not reply to this message.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>