<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome To Life Share</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif; color:#333333;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f7fb; padding:40px 15px;">
        <tr>
            <td align="center">

                <!-- Main Container -->
                <table width="600" cellpadding="0" cellspacing="0" border="0"
                    style="max-width:600px; width:100%; background:#ffffff; border-radius:12px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background:#0d9488; padding:35px 20px;">
                            <h1 style="margin:0; color:#ffffff; font-size:28px;">
                                Life Share
                            </h1>
                            <p style="margin:10px 0 0; color:#dff8f5; font-size:15px;">
                                Your health, our priority.
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:40px 35px;">

                            <h2 style="margin:0 0 20px; color:#1f2937; font-size:24px;">
                                Welcome, <%= name %>! 👋
                            </h2>

                            <p style="margin:0 0 15px; font-size:16px; line-height:1.7; color:#4b5563;">
                                Thank you for joining <strong>Life Share</strong>. We're excited to have you
                                as part of our community.
                            </p>

                            <p style="margin:0 0 25px; font-size:16px; line-height:1.7; color:#4b5563;">
                                Your account has been successfully created. You can now access our blood donation & emergency
                                services and manage your information securely.
                            </p>

                            <p style="margin:0; font-size:14px; line-height:1.6; color:#6b7280;">
                                If you did not create this account, please contact our support team immediately.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background:#f8fafc; padding:25px 20px; border-top:1px solid #e5e7eb;">
                            <p style="margin:0 0 8px; font-size:13px; color:#6b7280;">
                                © <%= new Date().getFullYear() %> Life Share. All rights reserved.
                            </p>

                            <p style="margin:0; font-size:12px; color:#9ca3af;">
                                This is an automated email. Please do not reply directly to this message.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>